{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Backend Go privado con ECS Fargate, RDS PostgreSQL, ALB HTTPS y Secrets Manager",
  "Parameters": {
    "ImageURI": {
      "Type": "String",
      "Description": "Imagen linux/amd64 versionada en ECR"
    },
    "CertificateArn": {
      "Type": "String",
      "Description": "Certificado ACM emitido para dominio API en esta región",
      "AllowedPattern": "arn:aws[a-z-]*:acm:.*"
    },
    "PostgresVersion": {
      "Type": "String",
      "Default": "17.11",
      "Description": "Confirmar disponibilidad de esta versión en RDS regional antes del despliegue"
    },
    "DatabaseClass": {
      "Type": "String",
      "Default": "db.t4g.micro"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "MaxValue": 4,
      "Description": "Mantener cero hasta aplicar migraciones y preparar rol"
    },
    "AIProvider": {
      "Type": "String",
      "Default": "disabled",
      "AllowedValues": [
        "disabled",
        "openai",
        "openai-compatible"
      ]
    },
    "AIModel": {
      "Type": "String",
      "Default": ""
    },
    "AIBaseURL": {
      "Type": "String",
      "Default": "https://api.openai.com/v1"
    },
    "ChatDailyLimit": {
      "Type": "String",
      "Default": "200",
      "AllowedPattern": "[0-9]+"
    }
  },
  "Resources": {
    "VPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-vpc"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-igw"
            }
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.42.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-public-1"
            }
          }
        ]
      }
    },
    "AppSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.42.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-app-1"
            }
          }
        ]
      }
    },
    "DBSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.42.21.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-db-1"
            }
          }
        ]
      }
    },
    "PublicRouteTable1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "PublicRoute1": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable1"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PublicAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet1"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable1"
        }
      }
    },
    "NATEIP1": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      },
      "DependsOn": "GatewayAttachment"
    },
    "NAT1": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NATEIP1",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicSubnet1"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-nat-1"
            }
          }
        ]
      }
    },
    "AppRouteTable1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "AppRoute1": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRouteTable1"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NAT1"
        }
      }
    },
    "AppAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "AppSubnet1"
        },
        "RouteTableId": {
          "Ref": "AppRouteTable1"
        }
      }
    },
    "DBRouteTable1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "DBAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "DBSubnet1"
        },
        "RouteTableId": {
          "Ref": "DBRouteTable1"
        }
      }
    },
    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.42.2.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-public-2"
            }
          }
        ]
      }
    },
    "AppSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.42.12.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-app-2"
            }
          }
        ]
      }
    },
    "DBSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.42.22.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-db-2"
            }
          }
        ]
      }
    },
    "PublicRouteTable2": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "PublicRoute2": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable2"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PublicAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnet2"
        },
        "RouteTableId": {
          "Ref": "PublicRouteTable2"
        }
      }
    },
    "NATEIP2": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      },
      "DependsOn": "GatewayAttachment"
    },
    "NAT2": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "NATEIP2",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicSubnet2"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-nat-2"
            }
          }
        ]
      }
    },
    "AppRouteTable2": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "AppRoute2": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "AppRouteTable2"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NAT2"
        }
      }
    },
    "AppAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "AppSubnet2"
        },
        "RouteTableId": {
          "Ref": "AppRouteTable2"
        }
      }
    },
    "DBRouteTable2": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "DBAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "DBSubnet2"
        },
        "RouteTableId": {
          "Ref": "DBRouteTable2"
        }
      }
    },
    "ALBSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS publico y redireccion HTTP",
        "VpcId": {
          "Ref": "VPC"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "CidrIp": "10.42.0.0/16"
          }
        ]
      }
    },
    "APISecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "API solo accesible desde ALB",
        "VpcId": {
          "Ref": "VPC"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {
              "Ref": "ALBSecurityGroup"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": "10.42.0.0/16"
          }
        ]
      }
    },
    "DBSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL privado solo desde ECS",
        "VpcId": {
          "Ref": "VPC"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "APISecurityGroup"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": "127.0.0.1/32"
          }
        ]
      }
    },
    "AdminPassword": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Credencial administrativa de PostgreSQL",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"portfolio_admin\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApplicationPassword": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Credencial limitada de backend_api",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"backend_api\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AISecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Configurar api_key fuera de CloudFormation",
        "SecretString": "{\"api_key\":\"\"}"
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DBSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "RDS sin ruta pública",
        "SubnetIds": [
          {
            "Ref": "DBSubnet1"
          },
          {
            "Ref": "DBSubnet2"
          }
        ]
      }
    },
    "DBParameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "TLS requerido",
        "Family": "postgres17",
        "Parameters": {
          "rds.force_ssl": "1"
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "PostgresVersion"
        },
        "DBInstanceClass": {
          "Ref": "DatabaseClass"
        },
        "DBName": "portfolio",
        "MasterUsername": "portfolio_admin",
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${AdminPassword}:SecretString:password}}"
        },
        "AllocatedStorage": "20",
        "MaxAllocatedStorage": 100,
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "PubliclyAccessible": false,
        "MultiAZ": true,
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "CopyTagsToSnapshot": true,
        "DBSubnetGroupName": {
          "Ref": "DBSubnetGroup"
        },
        "DBParameterGroupName": {
          "Ref": "DBParameters"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DBSecurityGroup"
          }
        ],
        "EnableCloudwatchLogsExports": [
          "postgresql"
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-rds"
            }
          }
        ]
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "DatabaseURLSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Conexión de aplicación sin privilegios administrativos",
        "SecretString": {
          "Fn::Sub": "{\"DATABASE_URL\":\"postgres://backend_api:{{resolve:secretsmanager:${ApplicationPassword}:SecretString:password}}@${Database.Endpoint.Address}:5432/portfolio?sslmode=verify-full\"}"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AdminURLSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Conexión solo para migraciones y preparación",
        "SecretString": {
          "Fn::Sub": "{\"DATABASE_URL\":\"postgres://portfolio_admin:{{resolve:secretsmanager:${AdminPassword}:SecretString:password}}@${Database.Endpoint.Address}:5432/portfolio?sslmode=verify-full\"}"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/portfolio/${AWS::StackName}"
        },
        "RetentionInDays": 30
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ecs-tasks.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadAssignedSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "DatabaseURLSecret"
                    },
                    {
                      "Ref": "AISecret"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "AdminExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ecs-tasks.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadAssignedSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "AdminURLSecret"
                    },
                    {
                      "Ref": "ApplicationPassword"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ecs-tasks.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        }
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "Family": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "backend",
            "Image": {
              "Ref": "ImageURI"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "ReadonlyRootFilesystem": true,
            "Environment": [
              {
                "Name": "APP_ENV",
                "Value": "production"
              },
              {
                "Name": "PORT",
                "Value": "8080"
              },
              {
                "Name": "CORS_ALLOWED_ORIGINS",
                "Value": "https://jd-aristizabal.vercel.app"
              },
              {
                "Name": "AI_PROVIDER",
                "Value": {
                  "Ref": "AIProvider"
                }
              },
              {
                "Name": "AI_MODEL",
                "Value": {
                  "Ref": "AIModel"
                }
              },
              {
                "Name": "AI_BASE_URL",
                "Value": {
                  "Ref": "AIBaseURL"
                }
              },
              {
                "Name": "CHAT_DAILY_LIMIT",
                "Value": {
                  "Ref": "ChatDailyLimit"
                }
              },
              {
                "Name": "TRUSTED_PROXY_CIDRS",
                "Value": "10.42.1.0/24,10.42.2.0/24"
              }
            ],
            "Secrets": [
              {
                "Name": "DATABASE_URL",
                "ValueFrom": {
                  "Fn::Sub": "${DatabaseURLSecret}:DATABASE_URL::"
                }
              },
              {
                "Name": "AI_API_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${AISecret}:api_key::"
                }
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1"
              ],
              "Interval": 30,
              "Timeout": 3,
              "Retries": 3,
              "StartPeriod": 15
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api"
              }
            }
          }
        ]
      }
    },
    "AdminTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "Family": {
          "Fn::Sub": "${AWS::StackName}-admin"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "AdminExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "backend",
            "Image": {
              "Ref": "ImageURI"
            },
            "Essential": true,
            "ReadonlyRootFilesystem": true,
            "EntryPoint": [
              "/bin/sh",
              "-c"
            ],
            "Command": [
              "exec /app/migrate up"
            ],
            "Secrets": [
              {
                "Name": "DATABASE_URL",
                "ValueFrom": {
                  "Fn::Sub": "${AdminURLSecret}:DATABASE_URL::"
                }
              },
              {
                "Name": "APP_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${ApplicationPassword}:password::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "admin"
              }
            }
          }
        ]
      }
    },
    "ALB": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "PublicSubnet1"
          },
          {
            "Ref": "PublicSubnet2"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "ALBSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-alb"
            }
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/ready",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "HTTPSListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "ALB"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "HTTPListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "ALB"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "HealthCheckGracePeriodSeconds": 60,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "SecurityGroups": [
              {
                "Ref": "APISecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Ref": "AppSubnet1"
              },
              {
                "Ref": "AppSubnet2"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "backend",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ],
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE"
      },
      "DependsOn": [
        "HTTPSListener",
        "AppRoute1",
        "AppRoute2"
      ]
    }
  },
  "Outputs": {
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      },
      "Description": "Clúster ECS"
    },
    "Service": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      },
      "Description": "Servicio ECS"
    },
    "TaskDefinition": {
      "Value": {
        "Ref": "TaskDefinition"
      },
      "Description": "Definición API"
    },
    "AdminTaskDefinition": {
      "Value": {
        "Ref": "AdminTaskDefinition"
      },
      "Description": "Tarea administrativa para migrate y provision"
    },
    "AppSubnets": {
      "Value": {
        "Fn::Join": [
          ",",
          [
            {
              "Ref": "AppSubnet1"
            },
            {
              "Ref": "AppSubnet2"
            }
          ]
        ]
      },
      "Description": "Subredes privadas"
    },
    "APISecurityGroup": {
      "Value": {
        "Ref": "APISecurityGroup"
      },
      "Description": "Security group para tareas"
    },
    "ALBHost": {
      "Value": {
        "Fn::GetAtt": [
          "ALB",
          "DNSName"
        ]
      },
      "Description": "Destino DNS del dominio API"
    },
    "ALBHostedZone": {
      "Value": {
        "Fn::GetAtt": [
          "ALB",
          "CanonicalHostedZoneID"
        ]
      },
      "Description": "Zone ID para alias Route 53"
    },
    "AISecretArn": {
      "Value": {
        "Ref": "AISecret"
      },
      "Description": "Guardar api_key aquí sin archivos versionados"
    },
    "DatabaseURLSecretArn": {
      "Value": {
        "Ref": "DatabaseURLSecret"
      },
      "Description": "Secreto de aplicación"
    },
    "AdminURLSecretArn": {
      "Value": {
        "Ref": "AdminURLSecret"
      },
      "Description": "Secreto administrativo"
    },
    "ApplicationPasswordArn": {
      "Value": {
        "Ref": "ApplicationPassword"
      },
      "Description": "Contraseña de rol backend_api"
    },
    "LogGroup": {
      "Value": {
        "Ref": "Logs"
      },
      "Description": "Logs de contenedor"
    },
    "RDSEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      },
      "Description": "RDS privado"
    }
  }
}
